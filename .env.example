#AWS IAM CONFIG
AWS_ACCESS_KEY_ID="AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="AWS_SECRET_ACCESS_KEY"

#AWS_REGION CONFIG
AWS_REGION="us-east-1"

#BEDROCK CONFIG
BEDROCK_EMBEDDED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
EMBED_DIM=1024

#S3 CONFIG
S3_BUCKET_NAME="enterprise-rag-2026"

#PINECONE VECTOR DB CONFIG
PINECONE_API_KEY = "PINECONE_API_KEY"
PINECONE_INDEX_NAME="enterprise-rag-index"
PINECONE_CLOUD=aws
PINECONE_ENVIRONMENT=us-east-1
PINECONE_READY_TIMEOUT=180

#RENDER PG DB
PG_DB_HOST= PG_DB_HOST

#RIUS CONFIG  - Observability and tracing for AI agents
RIUS_API_KEY= "RIUS_API_KEY"
RIUS_SERVICE_NAME= "enterprise-rag-application"
RIUS_DISABLE_TRACING= false
RIUS_CAPTURE_CONTENT = false